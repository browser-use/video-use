# Transcription backend — configure ONE of these, not both.
#
# A) Local whisper-cli (whisper.cpp). Free, offline, no key. Default.
#    Path to a ggml model .bin. If unset, defaults to
#    ~/whisper-models/ggml-large-v3-turbo.bin
WHISPER_MODEL=

# B) Hosted ElevenLabs Scribe. Only needed for speaker diarization and
#    audio events, which local whisper does not produce.
ELEVENLABS_API_KEY=
